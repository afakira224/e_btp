# ─────────────────────────────────────────────
#  Serveur
# ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Niveau de log Winston : error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# URL publique du front, utilisée dans les liens des emails
APP_URL=http://localhost:3000
APP_NAME=BTP

# Origines autorisées par CORS, séparées par des virgules.
# Obligatoire dès que le front est sur un autre domaine : le cookie de session
# n'est transmis que si l'origine du front est explicitement autorisée.
CORS_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────
#  Base de données
#  Les transactions exigent un replica set : utilisez MongoDB Atlas
#  (mongodb+srv://) ou un replica set local (?replicaSet=rs0).
# ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://utilisateur:motdepasse@cluster.mongodb.net/btp

# ─────────────────────────────────────────────
#  Authentification par session
#  Générer le secret avec : openssl rand -base64 48
# ─────────────────────────────────────────────
SESSION_SECRET=changez-moi-secret-de-session

# Nom du cookie de session.
SESSION_NAME=btp.sid

# Durée de vie d'une session inactive, en jours.
SESSION_TTL_DAYS=7

# Cookie réservé au HTTPS. Par défaut : true en production, false sinon.
# COOKIE_SECURE=true

# SameSite du cookie : lax | strict | none.
# Front et API sur des domaines différents → none (impose COOKIE_SECURE=true).
# COOKIE_SAME_SITE=lax

# Domaine du cookie, à renseigner pour le partager entre sous-domaines.
# COOKIE_DOMAIN=.example.com

# Faire confiance au reverse proxy (X-Forwarded-Proto). Activé d'office en production.
# TRUST_PROXY=true

# ─────────────────────────────────────────────
#  Envoi d'emails (SMTP)
# ─────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=utilisateur@example.com
MAIL_PASS=motdepasse

MAIL_FROM_NAME=BTP
MAIL_FROM_ADDRESS=noreply@example.com

# Destinataire du mail de test (développement uniquement)
MAIL_TEST_TO=test@example.com

# ── Commandes ───────────────────────────────
# Prestataire du paiement en ligne. « sandbox » = paiement simulé (page
# factice du front) ; c'est le défaut hors production. En production, laissé
# vide, le paiement en ligne est refusé : seul le paiement à la remise reste.
PAYMENT_PROVIDER=sandbox
# Destinataire des alertes de l'administration (litiges, boutiques muettes,
# livraisons bloquées). Vide : les alertes sont seulement journalisées.
ADMIN_EMAIL=
# « off » coupe la tâche des délais (expirations, clôtures) sur cette instance.
ORDER_SCHEDULER=on
